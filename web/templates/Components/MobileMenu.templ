package Components

templ MobileMenu() {
<div class="relative"  x-data="{ open: false }" >
	<button @click="open=true"  class="btn btn-circle">
		<span class="icon-[material-symbols--menu]"></span>
	</button>
	<ul @click.outside="open=false" @show="open" class="absolute top-14 menu bg-base-200 rounded-box w-56">
		<li><a>Item 1</a></li>
		<li>
			<details open>
				<summary>Parent</summary>
				<ul>
					<li><a>Submenu 1</a></li>
					<li><a>Submenu 2</a></li>
					<li>
						<details open>
							<summary>Parent</summary>
							<ul>
								<li><a>Submenu 1</a></li>
								<li><a>Submenu 2</a></li>
							</ul>
						</details>
					</li>
				</ul>
			</details>
		</li>
		<li><a>Item 3</a></li>
	</ul>
</div>
}
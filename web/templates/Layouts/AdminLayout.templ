package layouts

import "github.com/pzonouz/simple-store-golang-templ-htmx-alpinejs/web/templates/Components"
import "github.com/pzonouz/simple-store-golang-templ-htmx-alpinejs/myTypes"

templ AdminLayout(title string, menuItems []myTypes.MenuItemType) {
	@Components.Base(title) {
		@Components.Navbar(menuItems)
		{ children... }
	}
}
